<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application android:label="归藏启动桥" android:allowBackup="false" android:supportsRtl="true">
        <activity android:name=".BootProxyActivity" android:exported="true"
            android:theme="@android:style/Theme.NoDisplay" android:noHistory="true"
            android:excludeFromRecents="true" android:taskAffinity="">
            <!-- The vendor hook resolves INFO. Keep the normal launcher entry in the main APK. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.INFO" />
            </intent-filter>
        </activity>
    </application>
</manifest>
